var spider = document.querySelector(".spider");
var wall = document.querySelector(".wall");
document.addEventListener("click", function(e) {
    var wallPos = wall.getBoundingClientRect();
    if (e.clientX < wallPos.left || e.clientX > wallPos.right || e.clientY < wallPos.top || e.clientY > wallPos.bottom) return;
