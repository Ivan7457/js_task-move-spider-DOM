    var borderTop = wall.clientTop;
    var left = e.clientX - wallPos.left - spider.offsetWidth / 2 - borderLeft;
    var topPos = e.clientY - wallPos.top - spider.offsetHeight / 2 - borderTop;
    var maxLeft = wall.clientWidth - spider.clientWidth;
    var maxTop = wall.clientHeight - spider.clientHeight;
    if (left < 0) left = 0;
    if (left > maxLeft) left = maxLeft;
    if (topPos < 0) topPos = 0;
